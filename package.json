{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "npm run build:before && npm run build:after",
    "build:before": "cd versions/before && vite build --base=/demo/before/",
    "build:after": "cd versions/after && vite build --base=/demo/after/",
    "start": "tsx presentation/server.ts",
    "dev:after": "cd versions/after && tsx server.ts",
    "lint": "tsc --noEmit -p versions/before && tsc --noEmit -p versions/after",
    "test": "tsx --test versions/before/src/domain/*.test.ts versions/after/src/domain/*.test.ts versions/after/tests/*.test.ts",
    "test:e2e": "playwright test --config=versions/after/playwright.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
